<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_retention" model="ir.ui.view">
        <field name="name">account.move.form.retention</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_retention_entries" type="object" class="oe_stat_button" icon="fa-exchange"
                        string="Retention Entries" invisible="move_type not in ('out_invoice', 'out_refund') or state != 'posted'"/>
            </xpath>

            <!-- The deductions, shown just above the amount due -->
            <xpath expr="//field[@name='amount_residual'][hasclass('oe_subtotal_footer_separator')]" position="before">
                <field name="retention_amount" invisible="move_type != 'out_invoice' or not retention_amount"/>
                <field name="advance_recovery_amount" invisible="move_type != 'out_invoice' or not advance_recovery_amount"/>
                <field name="amount_to_pay_now" class="fw-bold"
                       invisible="move_type != 'out_invoice' or (not retention_amount and not advance_recovery_amount)"/>
            </xpath>

            <xpath expr="//page[@id='other_tab']" position="after">
                <page id="retention_tab" string="Retention &amp; Advance" name="retention_advance"
                      invisible="move_type != 'out_invoice'">
                    <group>
                        <group string="Retention">
                            <field name="retention_percent" readonly="state != 'draft'"/>
                            <field name="retention_handover_date" readonly="state != 'draft'"
                                   invisible="move_type != 'out_invoice'"
                                   required="move_type == 'out_invoice' and retention_percent &gt; 0 and state == 'draft'"/>
                            <field name="retention_balance" invisible="state != 'posted'"/>
                        </group>
                        <group string="Advance Recovery">
                            <field name="advance_payment_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="advance_recovery_type" readonly="state != 'draft'"
                                   invisible="not advance_payment_id" widget="radio"/>
                            <field name="advance_recovery_percent" readonly="state != 'draft'"
                                   invisible="not advance_payment_id or advance_recovery_type != 'percent'"/>
                            <field name="advance_recovery_fixed" readonly="state != 'draft'"
                                   invisible="not advance_payment_id or advance_recovery_type != 'fixed'"/>
                            <field name="advance_remaining" invisible="not advance_payment_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Summary">
                            <field name="retention_amount"/>
                            <field name="advance_recovery_amount"/>
                            <field name="amount_to_pay_now"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- The same figures in the customer invoice list -->
    <record id="view_out_invoice_tree_retention" model="ir.ui.view">
        <field name="name">account.out.invoice.list.retention</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="amount_total_in_currency_signed" position="after">
                <field name="retention_amount" string="Retention" sum="Total" optional="show"/>
                <field name="retention_released" string="Retention Released" sum="Total" optional="show"/>
                <field name="retention_balance" string="Retention Balance" sum="Total" optional="show"/>
                <field name="advance_recovery_amount" string="Advance Recovery" sum="Total" optional="show"/>
                <field name="amount_to_pay_now" string="Amount to Pay Now" sum="Total" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
