<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="retention_release_wizard_form" model="ir.ui.view">
        <field name="name">retention.release.wizard.form</field>
        <field name="model">retention.release.wizard</field>
        <field name="arch" type="xml">
            <form string="Release Retention">
                <div class="alert alert-warning" role="alert" invisible="not mixed_currencies">
                    The ticked invoices are in different currencies. Release them separately.
                </div>
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="partner_id" options="{'no_create': True}"/>
                        <field name="date"/>
                    </group>
                    <group>
                        <field name="release_mode" widget="radio"/>
                        <field name="amount" readonly="release_mode == 'full'"/>
                        <field name="total_selected"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="move_line_id" column_invisible="1" force_save="1"/>
                        <field name="selected"/>
                        <field name="invoice_id"/>
                        <field name="sale_order_id"/>
                        <field name="date_maturity"/>
                        <field name="residual" sum="Total"/>
                        <field name="amount_to_release" sum="Total"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_release" type="object" string="Release" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_retention_release_wizard" model="ir.actions.act_window">
        <field name="name">Release Retention</field>
        <field name="res_model">retention.release.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Same action, from the customer form -->
    <record id="view_partner_form_retention" model="ir.ui.view">
        <field name="name">res.partner.form.retention</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(retention_advance.action_retention_release_wizard)d" type="action"
                        class="oe_stat_button" icon="fa-unlock" string="Release Retention"
                        context="{'default_partner_id': id}" groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>
</odoo>
